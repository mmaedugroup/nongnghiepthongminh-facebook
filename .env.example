# Copy to .env and replace every value before starting Compose.
# Never commit .env.

N8N_IMAGE=docker.n8n.io/n8nio/n8n:1.123.4
POSTIZ_IMAGE=ghcr.io/gitroomhq/postiz-app:v2.4.0
POSTGRES_IMAGE=postgres:16.4
REDIS_IMAGE=redis:7.4.1-alpine

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=replace-with-a-long-random-password

POSTIZ_HOST=localhost
POSTIZ_PORT=5000
POSTIZ_DB_NAME=postiz
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=replace-with-a-different-long-random-password
POSTIZ_JWT_SECRET=replace-with-at-least-32-random-characters
POSTIZ_FRONTEND_URL=http://localhost:5000
POSTIZ_BACKEND_URL=http://localhost:5000/api

# Used only by the imported n8n workflow credentials, not Compose.
POSTIZ_URL=http://localhost:5000
TELEGRAM_CHAT_ID=replace-with-your-chat-id
